# Kasauti (india-runs) configuration. Copy to .env; every value is optional.
# No secrets belong in this file - it is committed.

# ── Engine ───────────────────────────────────────────────────────────
# hashing     = lite engine: deterministic, numpy-only, no model download (default in Docker)
# transformer = multilingual sentence-transformer embeddings (needs torch, ~1.5 GB RAM)
EMBEDDING_BACKEND=hashing
# Only with EMBEDDING_BACKEND=transformer; must match the model the index was built with.
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Cross-encoder reranker (transformer stack only). false = rerank on hybrid scores.
CROSS_ENCODER_ENABLED=false
CROSS_ENCODER_TIMEOUT_MS=500

# With no prebuilt index in data/indexes/, index this sample in memory at startup.
AUTO_INDEX=true
# SAMPLE_PROFILES_PATH=data/samples/sample_500.jsonl
# Where POST /api/v1/ingest persists profiles (replayed into the index on startup).
# INGESTED_PROFILES_PATH=data/profiles/ingested.jsonl

# ── Optional LLM agents (planner / listwise ranker / reflector / rationale) ──
# Without a key every search runs the deterministic turbo pipeline.
LLM_PROVIDER=openai
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
MAX_REPLAN_CYCLES=1

LOG_LEVEL=INFO

# Only needed for the full engine with Postgres; the lite engine runs without it.
# add your Postgres user and password to this URL if your server needs them
DATABASE_URL=postgresql://localhost:5432/india_runs
